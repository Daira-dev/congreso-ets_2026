
# Dependencias
node_modules/
**/node_modules/

# Compilaciones
frontend/.next/
frontend/out/
backend/dist/

# Variables de entorno y credenciales
.env
.env.*
!.env.example
backend/.env

# Backups locales
backend/backups/
backups/

# Almacenamiento local de materiales (preservar estructura)
imagenes_de_materiales/*
!imagenes_de_materiales/.gitkeep
frontend/public/imagenes_de_materiales/*
!frontend/public/imagenes_de_materiales/.gitkeep

# Logs y PIDs de procesos locales
*.log
*.pid
.*.pid
data_system.txt
